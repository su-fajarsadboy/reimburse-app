# Production env vars — paste these into Vercel project settings.
# Copy each row to Vercel → Settings → Environment Variables (Production scope).
# Do NOT commit values — this file documents the SHAPE only.

# Supabase (hosted) — from Settings → API in Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=<service_role JWT or sb_secret_...>

# NextAuth — must point to your production domain
NEXTAUTH_URL=https://<your-domain>.vercel.app
NEXTAUTH_SECRET=<openssl rand -base64 32>

# Admin login — used only for the seed script (one-shot)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<strong password>

# Upstash (optional, recommended for prod) — leave empty = NoOp rate limiter (allow all)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
