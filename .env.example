# Supabase (local Supabase CLI defaults; replace for prod)
# Run `npx supabase status` after `npm run db:start` to read your actual local
# publishable + secret keys (sb_publishable_* / sb_secret_*) and paste them here.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_REPLACE_WITH_LOCAL_OR_PROD
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_WITH_LOCAL_OR_PROD

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Admin seed (idempotent — only used when users table is empty)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123

# Upstash (optional — leave empty for NoOp rate limiter in dev)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
